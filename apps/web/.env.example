# Copy to `apps/web/.env.local` and fill in. Every `.env*` file except this one is
# gitignored and must never be committed. Names only in here — never a value.
#
# REQUIRED SINCE WORK ITEM 143. The game requires a signed-in account and cloud saves:
# with these unset, `/play` renders a "cloud is not configured" screen instead of the
# game. (The read path is still local-first — IndexedDB boots the game and a mid-session
# outage is invisible — but there is no anonymous, local-only mode any more.)

# Your project's URL, e.g. https://abcdefghijklmnop.supabase.co
# Dashboard → Project Settings → Data API.
NEXT_PUBLIC_SUPABASE_URL=

# The CLIENT key, safe to ship in a browser bundle. Prefixed `sb_publishable_…`.
# Dashboard → Project Settings → API Keys.
#
# This is the current generation of client key. It replaces the legacy `anon` JWT key,
# which Supabase has scheduled for retirement at the end of 2026. It carries exactly the
# same low privileges, so Row Level Security behaves identically.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Legacy fallback, only for a project that predates publishable keys. Prefixed `eyJ…`.
# Used ONLY when NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY is empty. Prefer the one above; this
# exists so an older project keeps working rather than needing a forced migration.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# NEVER PUT A SECRET KEY (`sb_secret_…`) OR A SERVICE ROLE KEY IN THIS FILE OR ANY OTHER
# FILE UNDER apps/web. Anything named NEXT_PUBLIC_* is compiled into the JavaScript every
# player downloads. Nothing in v0.1 reads this database from a server, so the web app has
# no legitimate use for a secret key at all.
