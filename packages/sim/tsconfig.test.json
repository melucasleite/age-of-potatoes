{
  // Tests are typechecked but never emitted, so they stay out of the composite build and
  // out of dist. `yarn workspace @snack/sim typecheck` runs this after the real build.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "composite": false,
    "rootDir": ".",
    "declaration": false,
    "declarationMap": false,
    // "node" is here for the golden fixture harness only — it reads fixture files and
    // spawns a second process to prove a replay survives a fresh interpreter. The sim's own
    // build (tsconfig.json) is unaffected, and `lib` still has no "DOM".
    "types": ["vitest/globals", "node"]
  },
  "include": ["src/**/*", "test/**/*"]
}
