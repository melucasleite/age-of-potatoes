# Copy to .env and fill in. .env is gitignored and must never be committed.

# Retro Diffusion — pixel art generation (sent as the X-RD-Token header).
# Keys look like rdpk-…  Get one at https://retrodiffusion.ai
RETRODIFFUSION_API_KEY=

# OpenAI — fallback art adapter only. Note the non-default variable name:
# the OpenAI SDK looks for OPENAI_API_KEY, so our CLI reads this one explicitly.
OPENAI_API_TOKEN=

# Supabase — anonymous auth + cloud save sync (added in work item 016).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
