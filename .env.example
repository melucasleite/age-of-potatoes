# Copy to .env and fill in. .env is gitignored and must never be committed.

# Retro Diffusion — pixel art generation (sent as the X-RD-Token header).
# Keys look like rdpk-…  Get one at https://retrodiffusion.ai
RETRODIFFUSION_API_KEY=

# OpenAI — fallback art adapter only. Note the non-default variable name:
# the OpenAI SDK looks for OPENAI_API_KEY, so our CLI reads this one explicitly.
OPENAI_API_TOKEN=

# Supabase — anonymous auth + cloud save sync (work item 016).
#
# THESE DO NOT BELONG IN THIS FILE. Next.js reads env from the app directory, so the web
# app never sees anything set here — copy `apps/web/.env.example` to `apps/web/.env.local`
# instead. Listed here only so that grepping the repo for the names finds a signpost.
#
# All of it is optional: with no Supabase project configured the game is fully playable and
# saves normally to IndexedDB, and the Supabase SDK is not even downloaded.
